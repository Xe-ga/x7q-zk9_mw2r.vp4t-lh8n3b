---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/util';
---
<Base title="Страница не найдена" noindex>
  <div class="wrap nf">
    <p class="nf__code"><Icon name="skull" /> 404</p>
    <h1>Страница потрачена</h1>
    <p class="nf__text">Такой страницы нет. Возможно, игру переименовали или ссылка обрезалась при копировании.</p>
    <form class="nf__search" action={u('/search/')} method="get" role="search">
      <label for="nf-q" class="sr-only">Поиск</label>
      <input id="nf-q" class="field" type="search" name="q" placeholder="Поищите игру по названию" />
      <button class="btn btn--primary" type="submit">Найти</button>
    </form>
    <p><a class="link-more" href={u('/')}>На главную</a></p>
  </div>
</Base>
<style>
  .nf {
    padding-block: clamp(48px, 8vw, 110px) 0;
    max-width: 760px;
  }
  .nf__code {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: var(--f-mono);
    font-weight: 800;
    font-size: var(--s2);
    background: var(--red);
    color: #fff;
    border: var(--bw) solid var(--line);
    padding: 0.1em 0.5em;
    box-shadow: var(--sh);
    transform: rotate(-3deg);
    margin-bottom: 1.6rem;
  }
  .nf__text {
    font-size: var(--s1);
    max-width: 44ch;
    margin: 1.2rem 0 1.6rem;
  }
  .nf__search {
    display: flex;
    gap: 10px;
    max-width: 520px;
    margin-bottom: 1.6rem;
  }
</style>

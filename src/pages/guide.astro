---
// Шпаргалка для модераторов. В меню не выводится, ссылка — на панели модератора и на странице входа.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TypeTag from '../components/TypeTag.astro';
import VerdictTag from '../components/VerdictTag.astro';
import { TRANSLATION_TYPES, TRANSLATION_TYPE_KEYS, VERDICTS, VERDICT_KEYS } from '../data/taxonomy';
import { REPO } from '../config';
import { u } from '../lib/util';

const repoUrl = `https://github.com/${REPO.name}`;
---
<Base title="Шпаргалка модератора" description="Как добавлять игры и вести архив." noindex>
  <article class="wrap guide">
    <p class="label muted">Для модераторов</p>
    <h1>Шпаргалка</h1>
    <p class="guide__lead">
      Всё, что нужно, чтобы добавлять игры и следить за архивом. Сначала один раз настройте доступ, дальше —
      только редактор на сайте.
    </p>

    <nav class="guide__toc" aria-label="Разделы шпаргалки">
      <a href="#start"><b>1</b>Первый вход</a>
      <a href="#add"><b>2</b>Добавить игру</a>
      <a href="#fields"><b>3</b>Что писать в анкете</a>
      <a href="#blog"><b>4</b>Блог</a>
      <a href="#daily"><b>5</b>Заявки и комментарии</a>
      <a href="#broken"><b>6</b>Если что-то сломалось</a>
    </nav>

    <!-- 1 -->
    <section class="guide__sec" id="start" aria-labelledby="start-h">
      <h2 id="start-h"><span class="guide__n">1</span>Первый вход <span class="label muted">делается один раз</span></h2>

      <ol class="steps">
        <li class="step">
          <h3>Примите приглашение</h3>
          <p>
            Владелец сайта добавляет вас в репозиторий на GitHub. Вам придёт письмо — нажмите в нём
            <b>Accept invitation</b>. Письма нет — приглашение лежит на
            <a href="https://github.com/notifications" rel="noopener" target="_blank">github.com/notifications</a>.
          </p>
        </li>
        <li class="step">
          <h3>Сделайте GitHub-токен</h3>
          <p>Это пропуск, с которым кнопка «Сохранить» в редакторе может записывать изменения на сайт.</p>
          <ol class="path">
            <li>На github.com: аватарка справа вверху → <b>Settings</b></li>
            <li>В самом низу слева → <b>Developer settings</b></li>
            <li><b>Personal access tokens</b> → <b>Tokens (classic)</b></li>
            <li><b>Generate new token</b> → <b>Generate new token (classic)</b></li>
          </ol>
          <dl class="form-demo">
            <div><dt>Note</dt><dd><code>ruspatch редактор</code></dd></div>
            <div><dt>Expiration</dt><dd>1 год <span class="muted">(через год сделаете новый)</span></dd></div>
            <div><dt>Галочки</dt><dd>только <code>public_repo</code></dd></div>
          </dl>
          <p>
            Нажмите <b>Generate token</b> внизу и сразу скопируйте токен (начинается с <code>ghp_</code>) — второй раз GitHub его не покажет.
          </p>
        </li>
        <li class="step">
          <h3>Вставьте токен в редактор</h3>
          <p>
            Откройте <a href={u('/editor/')}>редактор</a>, вставьте токен в поле справа вверху и нажмите <b>«Войти»</b>.
            Браузер его запомнит.
          </p>
        </li>
        <li class="step">
          <h3>Войдите ключом модератора</h3>
          <p>
            Ключ вам выдаёт владелец сайта. Введите его на странице <a href={u('/moderator/')}>/moderator/</a> — внизу экрана
            появится чёрная панель модератора, а у комментариев — кнопка «Удалить».
          </p>
        </li>
      </ol>

      <aside class="warn">
        <Icon name="exclamation-triangle" />
        <p>
          <b>Токен и ключ — как пароли.</b> Никому их не пересылайте, даже другим модераторам, и вставляйте только на этом сайте.
          Засветили токен — удалите его там же, в Developer settings, и сделайте новый.
        </p>
      </aside>

      <details class="owner">
        <summary>Для владельца: как пригласить модератора и сделать себе токен</summary>
        <div class="owner__body">
          <h3>Пригласить модератора</h3>
          <ol>
            <li>Откройте <a href={repoUrl} rel="noopener" target="_blank">репозиторий сайта</a> → <b>Settings</b> → <b>Collaborators</b>.</li>
            <li><b>Add people</b> → ник на GitHub → <b>Add to repository</b>.</li>
            <li>
              Выдать ключ модератора: Supabase → <b>SQL Editor</b> → <b>New query</b>, вставить и нажать <b>Run</b>:
              <pre><code>insert into public.moderators values ('Имя', extensions.crypt('ПРИДУМАННЫЙ-КЛЮЧ', extensions.gen_salt('bf')));</code></pre>
              Ключ передайте лично.
            </li>
          </ol>
          <h3>Токен владельца</h3>
          <p>Владельцу подходит и способ выше, но надёжнее токен с доступом только к сайту:</p>
          <ol>
            <li>Developer settings → <b>Personal access tokens</b> → <b>Fine-grained tokens</b> → <b>Generate new token</b>.</li>
            <li>Expiration: <b>Custom</b>, через год. Repository access: <b>Only select repositories</b> → репозиторий сайта.</li>
            <li>Permissions → <b>Contents: Read and write</b>. Generate → скопировать <code>github_pat_…</code> → вставить в редактор.</li>
          </ol>
        </div>
      </details>
    </section>

    <!-- 2 -->
    <section class="guide__sec" id="add" aria-labelledby="add-h">
      <h2 id="add-h"><span class="guide__n">2</span>Добавить или изменить игру</h2>
      <div class="cards">
        <div class="card">
          <span class="card__ico"><Icon name="tag" /></span>
          <h3>Новая игра</h3>
          <p>Кнопка на панели модератора. Слева анкета, справа сразу видно, как карточка будет выглядеть на сайте.</p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="pen" /></span>
          <h3>Изменить</h3>
          <p>На странице любой игры — «Изменить эту страницу». Откроется та же анкета с заполненными полями.</p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="upload" /></span>
          <h3>Обложка</h3>
          <p>Выберите файл, перетащите мышкой или вставьте <kbd>Ctrl</kbd>+<kbd>V</kbd>. Откроется окно обрезки — рамка как на сайте.</p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="refresh" /></span>
          <h3>Сохранить</h3>
          <p>После «Сохранить» сайт обновится сам через 1–2 минуты. Обновите страницу через <kbd>Ctrl</kbd>+<kbd>F5</kbd>.</p>
        </div>
      </div>
      <ul class="ticks">
        <li>Новых переводчиков и издателей вписывайте прямо в анкете — отдельно заводить не нужно.</li>
        <li>Кнопки «+» добавляют свою отметку «что не переведено» или свой жанр. После сохранения они появятся в списке у всех модераторов.</li>
        <li>Пока карточка не сохранена, черновик хранится в браузере — случайно закрытая вкладка ничего не потеряет.</li>
        <li>Добавили новый перевод к старой игре — обновите дату, и игра снова поднимется в «Свежие переводы» на главной.</li>
      </ul>
    </section>

    <!-- 3 -->
    <section class="guide__sec" id="fields" aria-labelledby="fields-h">
      <h2 id="fields-h"><span class="guide__n">3</span>Что писать в анкете</h2>

      <div class="cols">
        <div class="panel legend">
          <h3 class="label">Тип перевода</h3>
          <dl>
            {TRANSLATION_TYPE_KEYS.map((t) => (
              <div class="legend__row"><dt><TypeTag type={t} big link /></dt><dd>{TRANSLATION_TYPES[t].hint}.</dd></div>
            ))}
          </dl>
        </div>
        <div class="panel legend">
          <h3 class="label">Рекомендация модератора</h3>
          <dl>
            {VERDICT_KEYS.map((v) => (
              <div class="legend__row"><dt><VerdictTag verdict={v} big link /></dt><dd>{VERDICTS[v].hint}.</dd></div>
            ))}
          </dl>
          <p class="legend__foot muted">Не заполнили — будет «Не проверено». Переводы одной игры сайт сам сортирует от лучшего к худшему.</p>
        </div>
      </div>

      <dl class="fields">
        <div><dt>Название, другие названия</dt><dd>Как на коробке. Японское, европейское и т.п. — в «другие названия»: по ним тоже ищут.</dd></div>
        <div><dt>Своё название и «почему»</dt><dd>Можно переименовать уровень (например «Через боль» вместо «Терпимо») и объяснить оценку одной-двумя фразами. Для низкой оценки обязательно напишите, что плохо.</dd></div>
        <div><dt>Состояние</dt><dd>Полный, Частичный или В процессе. Галочка «Обновляется» — если автор ещё выпускает правки.</dd></div>
        <div><dt>Что не переведено</dt><dd>Графика, DLC, ролики, озвучка или своя отметка. Сноска — одной фразой: «не переведены главы 5–7».</dd></div>
        <div><dt>Переводчики</dt><dd>После публикации состав не меняйте — к нему привязаны оценки игроков.</dd></div>
        <div><dt>Порт</dt><dd>Если готовый перевод перенесли на другую версию игры. В «Переводчиках» — авторы оригинала, в «Портировщиках» — кто переносил.</dd></div>
        <div><dt>Ссылки</dt><dd>Ресурс переводчика — главная кнопка «Скачать». Пост в Telegram — вторая, скромная. Нужна хотя бы одна.</dd></div>
        <div><dt>Комментарии</dt><dd>Ваш — жёлтый блок под переводом. Комментарий переводчика — если он просил что-то передать. Пусто — блока нет.</dd></div>
      </dl>
      <p class="muted">Поля со звёздочкой ★ при наведении подсказывают, что в них писать.</p>
    </section>

    <!-- 4 -->
    <section class="guide__sec" id="blog" aria-labelledby="blog-h">
      <h2 id="blog-h"><span class="guide__n">4</span>Написать в блог</h2>
      <div class="cards">
        <div class="card">
          <span class="card__ico"><Icon name="newspaper" /></span>
          <h3>Новая запись</h3>
          <p>Откройте раздел «Блог» — на панели модератора появится кнопка «Новая запись». Или сразу <a href={u('/editor/blog/')}>редактор блога</a>.</p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="pen" /></span>
          <h3>Текст</h3>
          <p>Пишите как обычно. Кнопки над текстом: <b>Ж</b>, <i>К</i>, подзаголовок, список, цитата, ссылка.</p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="upload" /></span>
          <h3>Картинки</h3>
          <p><kbd>Ctrl</kbd>+<kbd>V</kbd> в тексте — картинка встанет туда, где курсор. Вне текста — станет картинкой над записью.</p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="refresh" /></span>
          <h3>Править и удалять</h3>
          <p>На странице записи — «Изменить эту страницу». Там же внизу — «Удалить запись».</p>
        </div>
      </div>
      <ul class="ticks">
        <li>Справа сразу видно, как запись будет выглядеть на сайте. На телефоне — вкладка «Предпросмотр».</li>
        <li>Галочка «Черновик» — запись сохранится, но на сайте не появится, пока её не снимете.</li>
      </ul>
    </section>

    <!-- 5 -->
    <section class="guide__sec" id="daily" aria-labelledby="daily-h">
      <h2 id="daily-h"><span class="guide__n">5</span>Заявки и комментарии</h2>
      <div class="cards cards--2">
        <div class="card">
          <span class="card__ico"><Icon name="comments" /></span>
          <h3>Присланные переводы</h3>
          <p>
            Посетители присылают их кнопкой «Отправить перевод». Заявки — на панели, кнопка «Заявки».
            Проверьте перевод, добавьте игру через «Новая игра» и отметьте заявку «Принят», чтобы другой модератор не взялся за неё второй раз.
          </p>
        </div>
        <div class="card">
          <span class="card__ico"><Icon name="trash" /></span>
          <h3>Спам в комментариях</h3>
          <p>
            Пока вы вошли ключом, у каждого комментария есть кнопка «Удалить». Ваши комментарии подписаны вашим именем
            с пометкой «модератор». Ссылки в комментариях сайт и так не пропускает.
          </p>
        </div>
      </div>
    </section>

    <!-- 6 -->
    <section class="guide__sec" id="broken" aria-labelledby="broken-h">
      <h2 id="broken-h"><span class="guide__n">6</span>Если что-то сломалось</h2>
      <dl class="fields">
        <div><dt>«Сохранить» выдаёт ошибку</dt><dd>Скорее всего, токен истёк или удалён. Сделайте новый (шаг 1) и вставьте в редактор.</dd></div>
        <div><dt>Сайт не обновился за 5 минут</dt><dd>Откройте <a href={`${repoUrl}/actions`} rel="noopener" target="_blank">вкладку Actions</a> на GitHub. Красный крестик — ошибка при сборке, чаще всего из-за неправильной ссылки. Откройте последнюю игру в редакторе и проверьте поля.</dd></div>
        <div><dt>Испортили карточку</dt><dd>Ничего страшного: GitHub хранит всю историю, любую правку можно откатить. Напишите владельцу.</dd></div>
      </dl>
    </section>
  </article>
</Base>

<style>
  .guide {
    padding-top: clamp(24px, 4vw, 48px);
    max-width: 980px;
  }
  .guide h1 {
    margin-top: 0.3rem;
  }
  .guide__lead {
    font-size: 1.15rem;
    max-width: 60ch;
    margin: 1rem 0 0;
  }
  .guide__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1.6rem;
  }
  .guide__toc a {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.45em 0.9em 0.45em 0.45em;
    background: var(--surface);
    border: var(--bw) solid var(--line);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--shadow-c);
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
  }
  .guide__toc a:hover {
    background: var(--yellow);
    color: #15130f;
  }
  .guide__toc b,
  .guide__n {
    display: inline-grid;
    place-items: center;
    width: 1.7em;
    height: 1.7em;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--f-mono);
    font-size: 0.85em;
  }
  .guide__sec {
    margin-top: clamp(44px, 6vw, 72px);
    scroll-margin-top: 90px;
  }
  .guide__sec > h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 1.2rem;
  }
  .guide__sec > h2 .label {
    font-size: 0.7rem;
  }
  .guide__n {
    font-size: 0.6em;
    background: var(--yellow);
    color: #15130f;
    border: var(--bw) solid var(--line);
  }

  /* пошаговая инструкция */
  .steps {
    list-style: none;
    counter-reset: st;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .step {
    counter-increment: st;
    position: relative;
    padding: 18px 22px 18px 74px;
    background: var(--surface);
    border: var(--bw) solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--sh);
  }
  .step::before {
    content: counter(st);
    position: absolute;
    left: 18px;
    top: 16px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--teal);
    color: #15130f;
    border: var(--bw) solid var(--line);
    border-radius: 8px;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.2rem;
  }
  .step h3 {
    margin: 0.35rem 0 0.4rem;
  }
  .step p {
    margin: 0.5rem 0 0;
  }
  .path {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .path li {
    padding: 0.3em 0.7em;
    background: var(--paper);
    border: var(--bw-thin) solid var(--line);
    border-radius: 6px;
    font-size: 0.95rem;
  }
  .path li:not(:last-child)::after {
    content: ' →';
    color: var(--ink-2);
  }
  .form-demo {
    margin: 0.9rem 0 0;
    border: var(--bw) solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    max-width: 460px;
  }
  .form-demo div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    border-bottom: var(--bw-thin) solid var(--line);
  }
  .form-demo div:last-child {
    border-bottom: 0;
  }
  .form-demo dt {
    padding: 0.45rem 0.7rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--f-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .form-demo dd {
    margin: 0;
    padding: 0.45rem 0.7rem;
    background: var(--paper);
  }
  code {
    font-family: var(--f-mono);
    font-size: 0.88em;
    padding: 0.05em 0.35em;
    background: var(--paper-2);
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  kbd {
    font-family: var(--f-mono);
    font-size: 0.82em;
    padding: 0.05em 0.4em;
    border: 1.5px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 4px;
    background: var(--surface);
  }

  .warn {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 22px;
    padding: 16px 20px;
    background: var(--yellow);
    color: #15130f;
    border: var(--bw) solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--sh);
  }
  .warn :global(.ico) {
    width: 28px;
    height: 28px;
    flex: none;
  }
  .warn p {
    margin: 0;
  }

  .owner {
    margin-top: 22px;
    border: var(--bw) dashed var(--ink-2);
    border-radius: var(--r-card);
  }
  .owner summary {
    cursor: pointer;
    padding: 14px 20px;
    font-weight: 700;
  }
  .owner__body {
    padding: 0 20px 18px;
  }
  .owner h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.05rem;
  }
  .owner ol {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: 0.4rem;
  }
  .owner pre {
    margin: 0.5rem 0;
    padding: 0.7rem 0.9rem;
    background: #15130f;
    color: #f2ede1;
    border-radius: 6px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .owner pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  /* карточки-действия */
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .cards--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .card {
    padding: 18px;
    background: var(--surface);
    border: var(--bw) solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--sh);
  }
  .card__ico {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--yellow);
    color: #15130f;
    border: var(--bw) solid var(--line);
    border-radius: 8px;
  }
  .card__ico :global(.ico) {
    width: 24px;
    height: 24px;
  }
  .card h3 {
    margin: 0.8rem 0 0.4rem;
    font-size: 1.05rem;
  }
  .card p {
    margin: 0;
    font-size: 0.95rem;
  }
  .ticks {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: grid;

---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getPosts, u, fmtDate } from '../../lib/util';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base edit={`blog/entries/${post.id}`} title={post.data.title} description={post.data.excerpt ?? undefined}>
  <article class="wrap bp">
    <p class="label muted"><a href={u('/blog/')}>Блог</a> / <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time></p>
    <h1 class="bp__t">{post.data.title}</h1>
    {post.data.excerpt && <p class="bp__lead">{post.data.excerpt}</p>}
    {post.data.cover && <Image src={post.data.cover} alt="" widths={[720, 1200]} sizes="(max-width: 800px) 100vw, 760px" class="bp__cover" />}
    <div class="prose"><Content /></div>
    <p class="bp__back"><a class="link-more" href={u('/blog/')}>← Все записи</a></p>
  </article>
</Base>
<style>
  .bp {
    max-width: 820px;
    padding-top: clamp(28px, 4vw, 52px);
  }
  .bp__t {
    font-size: clamp(var(--s3), 5vw, var(--s5));
    margin: 0.8rem 0 1rem;
  }
  .bp__lead {
    font-size: var(--s1);
    max-width: 50ch;
    color: var(--ink-2);
  }
  .bp :global(.bp__cover) {
    width: 100%;
    border: var(--bw) solid var(--line);
    border-radius: var(--r-panel);
    box-shadow: var(--sh);
    margin: 1.5rem 0 2rem;
  }
  .bp__back {
    margin-top: 3rem;
  }
</style>

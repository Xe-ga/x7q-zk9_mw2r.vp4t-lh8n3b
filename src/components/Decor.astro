---
// Узоры по краям широкого экрана: полупрозрачные силуэты консолей (те же иконки,
// что на обложках-заглушках) вперемешку с растровыми точками.
// Видны только там, где по бокам есть пустое место (от ~1400px), и уходят под подвал.
import { u } from '../lib/util';

type Item = { kind: 'icon'; slug: string; size: number; rot: number; x: number } | { kind: 'dots'; w: number; h: number; x: number };
const left: Item[] = [
  { kind: 'dots', w: 100, h: 70, x: 0 },
  { kind: 'icon', slug: 'gb', size: 92, rot: -10, x: 10 },
  { kind: 'icon', slug: 'snes', size: 118, rot: 7, x: 0 },
  { kind: 'dots', w: 60, h: 60, x: 40 },
  { kind: 'icon', slug: 'n64', size: 108, rot: -6, x: 8 },
  { kind: 'icon', slug: 'megadrive', size: 100, rot: 9, x: 18 },
  { kind: 'dots', w: 100, h: 48, x: 6 },
  { kind: 'icon', slug: 'nds', size: 96, rot: -8, x: 4 },
];
const right: Item[] = [
  { kind: 'icon', slug: 'nes', size: 110, rot: 8, x: 12 },
  { kind: 'dots', w: 100, h: 80, x: 20 },
  { kind: 'icon', slug: 'gba', size: 104, rot: -9, x: 4 },
  { kind: 'icon', slug: 'ps1', size: 112, rot: 6, x: 14 },
  { kind: 'dots', w: 64, h: 64, x: 6 },
  { kind: 'icon', slug: 'dreamcast', size: 90, rot: -7, x: 22 },
  { kind: 'icon', slug: 'psp', size: 112, rot: 5, x: 4 },
  { kind: 'dots', w: 100, h: 52, x: 14 },
];
---
{[left, right].map((items, side) => (
  <div class:list={['decor', side ? 'decor--r' : 'decor--l']} aria-hidden="true">
    {items.map((it) =>
      it.kind === 'icon' ? (
        <span
          class="decor__ico"
          style={`--src:url('${u(`/icons/platforms/${it.slug}.svg`)}');--s:${it.size}px;--r:${it.rot}deg;--x:${it.x}px`}
        ></span>
      ) : (
        <span class="decor__dots" style={`--w:${it.w}px;--h:${it.h}px;--x:${it.x}px`}></span>
      ),
    )}
  </div>
))}

<style>
  .decor {
    display: none;
    position: fixed;
    top: 96px;
    bottom: 16px;
    z-index: -1; /* под содержимым и под подвалом */
    width: clamp(0px, calc((100vw - var(--wrap)) / 2 - 24px), 150px);
    flex-direction: column;
    justify-content: space-evenly;
    overflow: hidden;
    pointer-events: none;
  }
  .decor--l {
    left: 12px;
  }
  .decor--r {
    right: 12px;
  }
  @media (min-width: 1400px) {
    .decor {
      display: flex;
    }
  }
  /* как иконка на обложке-заглушке: тёмный силуэт, чуть повёрнутый, полупрозрачный */
  .decor__ico {
    display: block;
    flex: none;
    width: min(var(--s), 100%);
    aspect-ratio: 1;
    margin-left: var(--x);
    background: var(--ink);
    opacity: 0.14;
    transform: rotate(var(--r));
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
  }
  /* растр из точек */
  .decor__dots {
    display: block;
    flex: none;
    width: min(var(--w), 100%);
    height: var(--h);
    margin-left: var(--x);
    background: radial-gradient(var(--ink) 2px, transparent 2.4px) 0 0 / 12px 12px;
    opacity: 0.22;
  }
</style>

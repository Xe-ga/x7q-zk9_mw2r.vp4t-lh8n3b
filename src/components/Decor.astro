---
// Узоры по краям широкого экрана: растровые точки, зигзаги, звёзды, кольца — в стиле наклеек.
// Видны только там, где по бокам есть пустое место (от ~1400px), и уходят под подвал.
const dots = (x0: number, y0: number, cols: number, rows: number, step = 12, r = 2.2) =>
  Array.from({ length: cols * rows }, (_, i) => ({ cx: x0 + (i % cols) * step, cy: y0 + Math.floor(i / cols) * step, r }));
const star = (cx: number, cy: number, R: number, r: number) => {
  const pts: string[] = [];
  for (let i = 0; i < 8; i++) {
    const a = (Math.PI / 4) * i - Math.PI / 2;
    const rr = i % 2 ? r : R;
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  return pts.join(' ');
};
const zig = (x: number, y: number, n: number, w: number, h: number) =>
  Array.from({ length: n + 1 }, (_, i) => `${x + i * w},${y + (i % 2 ? h : 0)}`).join(' ');
---
<div class="decor decor--l" aria-hidden="true">
  <svg viewBox="0 0 140 900" preserveAspectRatio="xMidYMin meet">
    <g class="d-dots">{dots(14, 20, 9, 7).map((d) => <circle {...d} />)}</g>
    <g transform="translate(4 4)"><polyline class="d-shadow d-zig" points={zig(20, 150, 6, 17, 22)} /></g>
    <polyline class="d-zig d-zig--teal" points={zig(20, 150, 6, 17, 22)} />
    <polygon class="d-shadow" points={star(74, 290, 46, 12)} transform="translate(5 5)" />
    <polygon class="d-shape d-yellow" points={star(74, 290, 46, 12)} />
    <circle class="d-shadow d-ring-sh" cx="79" cy="445" r="34" />
    <circle class="d-ring" cx="74" cy="440" r="34" />
    <g class="d-chev">
      <polyline points="30,560 56,586 30,612" />
      <polyline points="62,560 88,586 62,612" />
      <polyline points="94,560 120,586 94,612" />
    </g>
    <g class="d-dots d-dots--sparse">{dots(18, 680, 5, 5, 22, 3).map((d) => <circle {...d} />)}</g>
    <rect class="d-shadow" x="34" y="820" width="70" height="40" rx="4" transform="translate(5 5)" />
    <rect class="d-shape d-orange" x="34" y="820" width="70" height="40" rx="4" />
  </svg>
</div>
<div class="decor decor--r" aria-hidden="true">
  <svg viewBox="0 0 140 900" preserveAspectRatio="xMidYMin meet">
    <circle class="d-shadow" cx="75" cy="75" r="40" />
    <circle class="d-shape d-magenta" cx="70" cy="70" r="40" />
    <circle class="d-hole" cx="70" cy="70" r="14" />
    <g class="d-dots">{dots(20, 160, 9, 9, 12, 2.2).map((d) => <circle {...d} />)}</g>
    <polygon class="d-shadow" points={star(70, 340, 30, 8)} transform="translate(4 4)" />
    <polygon class="d-shape d-teal" points={star(70, 340, 30, 8)} />
    <g transform="translate(4 4)"><polyline class="d-shadow d-zig" points={zig(16, 430, 6, 18, 20)} /></g>
    <polyline class="d-zig d-zig--yellow" points={zig(16, 430, 6, 18, 20)} />
    <path class="d-shadow" d="M30 620 A 44 44 0 0 1 118 620 Z" transform="translate(5 5)" />
    <path class="d-shape d-green" d="M30 620 A 44 44 0 0 1 118 620 Z" />
    <g class="d-plus">
      <path d="M40 700 v24 M28 712 h24" />
      <path d="M96 740 v24 M84 752 h24" />
      <path d="M52 790 v24 M40 802 h24" />
    </g>
    <polygon class="d-shadow" points={star(92, 860, 22, 6)} transform="translate(4 4)" />
    <polygon class="d-shape d-yellow" points={star(92, 860, 22, 6)} />
  </svg>
</div>

<style>
  .decor {
    display: none;
    position: fixed;
    top: 100px;
    bottom: 24px;
    z-index: -1; /* под содержимым и под подвалом */
    width: clamp(0px, calc((100vw - var(--wrap)) / 2 - 28px), 150px);
    pointer-events: none;
  }
  .decor--l {
    left: 14px;
  }
  .decor--r {
    right: 14px;
  }
  .decor svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  @media (min-width: 1400px) {
    .decor {
      display: block;
    }
  }
  .decor :global(.d-dots) {
    fill: var(--ink);
    opacity: 0.22;
  }
  .decor :global(.d-dots--sparse) {
    opacity: 0.3;
  }
  .decor :global(.d-shadow) {
    fill: #15130f;
    stroke: #15130f;
  }
  .decor :global(.d-shape) {
    stroke: #15130f;
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .decor :global(.d-yellow) {
    fill: var(--yellow);
  }
  .decor :global(.d-teal) {
    fill: var(--teal);
  }
  .decor :global(.d-magenta) {
    fill: var(--magenta);
  }
  .decor :global(.d-orange) {
    fill: var(--orange);
  }
  .decor :global(.d-green) {
    fill: var(--green);
  }
  .decor :global(.d-hole) {
    fill: var(--paper);
    stroke: #15130f;
    stroke-width: 3;
  }
  .decor :global(.d-zig) {
    fill: none;
    stroke-width: 9;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .decor :global(.d-zig--teal) {
    stroke: var(--teal);
  }
  .decor :global(.d-zig--yellow) {
    stroke: var(--yellow);
  }
  .decor :global(.d-ring) {
    fill: none;
    stroke: var(--magenta);
    stroke-width: 10;
  }
  .decor :global(.d-ring-sh) {
    fill: none;
    stroke-width: 10;
  }
  .decor :global(.d-chev) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 7;
    stroke-linecap: square;
    opacity: 0.75;
  }
  .decor :global(.d-plus) {
    fill: none;
    stroke: var(--teal);
    stroke-width: 7;
    stroke-linecap: square;
  }
</style>
